# Plantilla de variables de entorno. Copia este archivo como .env y completa los valores.
# El archivo .env está en .gitignore y NUNCA se sube al repositorio.

# --- DeepSeek (modelo único para RAG y wiki) ---------------------------------
# Clave: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash = DeepSeek-V4.1-Flash. Es el modelo que responde (RAG y wiki). No usar
# deepseek-v4-pro para responder (3-4 veces más caro); solo redacta borradores, ver abajo.
DEEPSEEK_MODEL=deepseek-flash
# La API activa el modo "thinking" por defecto, que genera más tokens de salida (más costo
# y más latencia). Aquí queda desactivado. Valores: enabled | disabled.
DEEPSEEK_THINKING=disabled
# Solo aplica si DEEPSEEK_THINKING=enabled. Niveles de la API: low | high | max
# (por defecto, high). Con thinking desactivado se ignora.
DEEPSEEK_REASONING_EFFORT=

# --- Llamadas al modelo --------------------------------------------------------
# La temperatura solo tiene efecto con thinking desactivado.
MODEL_TEMPERATURE=0
# Reintentos ante errores transitorios (429, 5xx, tiempo agotado), con espera creciente.
MODEL_MAX_RETRIES=3
MODEL_TIMEOUT_SECONDS=120

# --- Control de gasto ---------------------------------------------------------
# Tarifas en USD por millón de tokens, fuera de horas pico (la hora pico cuesta el doble).
# Fuente: https://api-docs.deepseek.com/quick_start/pricing (verificado el 4-nov-2026)
PRICE_INPUT_CACHE_MISS_USD_PER_M=0.15
PRICE_INPUT_CACHE_HIT_USD_PER_M=0.003
PRICE_OUTPUT_USD_PER_M=0.60
# Tope de gasto por corrida: el cliente se detiene al alcanzarlo
MAX_USD_PER_RUN=2.00

# --- Evaluación: redactor de preguntas y juez (decisión 0003) --------------------
# Redactor de borradores de preguntas. Sus borradores los verifica una persona.
DRAFT_MODEL=deepseek-v4-pro
# Tarifas de deepseek-v4-pro en USD por millón, fuera de horas pico (la hora pico cuesta el
# doble). Fuente: https://api-docs.deepseek.com/quick_start/pricing/ (verificado el 6-nov-2026;
# ojo: la dirección sin la barra final abre otra página). Sin estas variables el plan de
# borradores usa una cota de 4 veces las tarifas de Flash.
DRAFT_PRICE_INPUT_CACHE_MISS_USD_PER_M=0.66
DRAFT_PRICE_INPUT_CACHE_HIT_USD_PER_M=0.022
DRAFT_PRICE_OUTPUT_USD_PER_M=1.98
# Juez de correctitud: un modelo de otro proveedor que el que responde (regla 12), por el
# endpoint compatible con OpenAI de Gemini. Clave: https://aistudio.google.com/apikey
# Solo la necesita quien corre `wikillm.eval metricas --juez`.
GEMINI_API_KEY=
JUDGE_MODEL=gemini-3.1-flash-lite

# --- Embeddings (los usa el RAG) ----------------------------------------------
# Locales, para no gastar saldo de la API. Por defecto usan la GPU.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# cuda = GPU NVIDIA (por defecto, unas 7 veces más rápido). Si tu equipo NO tiene GPU
# NVIDIA, cámbialo a cpu.
EMBEDDING_DEVICE=cuda

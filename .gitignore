# Secretos: nunca se suben. La plantilla pública es .env.example
.env
.env.*
!.env.example

# Datos del corpus (los textos de arXiv tienen licencias propias).
# Se versionan solo la lista de identificadores y el manifiesto de metadatos.
data/raw/
data/processed/
data/gold/*
!data/gold/corpus.jsonl
!data/gold/spans.jsonl

# Índices vectoriales y cachés locales
chroma/
qdrant/
.chroma/
*.sqlite3

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Registros locales de depuración
*.log

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Registros de llamadas al modelo: contienen texto de papers, no se versionan
results/**/llamadas*.jsonl

# Hojas de anotación y citas literales: contienen texto de arXiv
data/preguntas/anotacion/

# Wikis generados por el brazo WikiLLM: texto derivado de arXiv, con su propio Git
data/wiki/

# Grabaciones del panel de demostración: incluyen fragmentos de papers, no se versionan
results/demo/grabaciones/
